MOUSEKEY_ENABLE = no     # Mouse keys (unused in this keymap; disabled to free flash space for OS detection)
RGBLIGHT_ENABLE = yes    # Enable WS2812 RGB underlight.
RGB_MATRIX_ENABLE = no   # crkbd defaults this on, but it conflicts with RGBLIGHT on the same WS2812 line
OLED_ENABLE     = yes
OLED_DRIVER     = ssd1306
LTO_ENABLE      = yes
OS_DETECTION_ENABLE = yes    # Auto-detect Mac vs Linux/Windows for Cmd/Ctrl remaps
